// GKD 订阅 | 抖音 · 关闭「我」页面的「一起参与话题 / 去发布」横幅
// 订阅后自动更新用：version 加 1 即可触发更新
{
  id: 6660123,
  name: '抖音-关闭参与话题发布横幅',
  version: 3,
  author: 'kiriko',
  checkUpdateUrl: 'https://gh-proxy.com/https://raw.githubusercontent.com/mihonobourbonx/gkd-douyin/main/gkd.json5',
  supportUri: 'https://github.com/mihonobourbonx/gkd-douyin/issues/new/choose',
  categories: [],
  apps: [
    {
      id: 'com.ss.android.ugc.aweme',
      name: '抖音',
      groups: [
        {
          key: 120,
          name: '局部广告-个人主页「一起参与话题」发布横幅',
          desc: '点击横幅右上角 [X] 关闭',
          fastQuery: true,
          matchTime: 10000,
          actionMaximum: 1,
          resetMatch: 'activity',
          rules: [
            {
              key: 0,
              name: '点击[X]-排在「去发布」之后',
              matches: '@[clickable=true][childCount=0][width<120 && height<120][visibleToUser=true] -(1,2,3) [text="去发布"]',
            },
            {
              key: 1,
              name: '点击[X]-排在「去发布」之前',
              matches: '@[clickable=true][childCount=0][width<120 && height<120][visibleToUser=true] +(1,2,3) [text="去发布"]',
            },
            {
              key: 2,
              name: '点击[X]中心-排在「去发布」之后',
              action: 'clickCenter',
              matches: '@[childCount=0][width<120 && height<120][visibleToUser=true] -(1,2,3) [text="去发布"]',
            },
            {
              key: 3,
              name: '点击[X]中心-排在「去发布」之前',
              action: 'clickCenter',
              matches: '@[childCount=0][width<120 && height<120][visibleToUser=true] +(1,2,3) [text="去发布"]',
            },
            {
              key: 4,
              name: '点击[X]-锚点「参与话题」之后',
              matches: '@[clickable=true][childCount=0][width<120 && height<120][visibleToUser=true] -(1,2,4) [text*="参与话题"]',
            },
            {
              key: 5,
              name: '点击[X]-锚点「参与话题」之前',
              matches: '@[clickable=true][childCount=0][width<120 && height<120][visibleToUser=true] +(1,2,4) [text*="参与话题"]',
            },
            {
              key: 6,
              name: '点击[X]-包裹层在「去发布」之后',
              matches: '@[clickable=true][childCount=0][width<120 && height<120][visibleToUser=true] <n * -(1,2) [text="去发布"]',
            },
            {
              key: 7,
              name: '点击[X]-包裹层在「去发布」之前',
              matches: '@[clickable=true][childCount=0][width<120 && height<120][visibleToUser=true] <n * +(1,2) [text="去发布"]',
            },
            {
              key: 8,
              name: '点击[X]-描述为关闭',
              matches: '@[desc="关闭" || desc="close" || desc="Close"][visibleToUser=true] -(1,3) [text="去发布"]',
            },
          ],
        },
      ],
    },
  ],
}
